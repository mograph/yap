{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yap",
  "version": "0.1.0",
  "identifier": "io.tinkerstudio.yap",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Yap",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "overlay",
        "title": "Yap",
        "url": "overlay.html",
        "width": 440,
        "height": 220,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Apple Development: Lou Ward (EVQF83NQ58)",
      "entitlements": "Entitlements.plist"
    }
  }
}
